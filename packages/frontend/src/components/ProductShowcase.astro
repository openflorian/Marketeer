---
// components/ProductShowcase.astro
interface Product {
  id: string;
  title: string;
  category: string;
  trendScore: number;
  forecastGrowth: number;
  epcValue: number;
  description: string;
  image: string;
  affiliateNetwork: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;

// Sortiere Produkte nach Trend + Forecast (Elite Ranking Algorithm)
const rankedProducts = products.sort((a, b) => {
  const scoreA = a.trendScore * a.forecastGrowth;
  const scoreB = b.trendScore * b.forecastGrowth;
  return scoreB - scoreA;
});
---

<section class="mb-20">
  <h2 class="text-3xl font-bold mb-8 flex items-center gap-3">
    <span>🛒</span>
    <span>TREND_BASED_SHOWCASE</span>
    <span class="ml-auto text-xs text-gray-500 font-mono">AI-Ranked</span>
  </h2>

  <!-- Grid mit intelligenter Skalierung basierend auf Priority Score -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 auto-rows-[240px]">
    {rankedProducts.map((product) => {
      const priorityScore = product.trendScore * product.forecastGrowth;
      
      let gridClasses = "col-span-1 row-span-1";
      let badgeColor = "bg-gray-700/50";
      let badgeLabel = "📈 TRENDING";

      if (priorityScore > 130) {
        gridClasses = "md:col-span-2 md:row-span-2 border-2 border-purple-500/50";
        badgeColor = "bg-gradient-to-r from-purple-500 to-pink-500 animate-pulse";
        badgeLabel = "🔥 HYPER_TREND";
      } else if (priorityScore > 85) {
        gridClasses = "md:col-span-2 md:row-span-1";
        badgeColor = "bg-indigo-600/70";
        badgeLabel = "📈 RISING";
      }

      return (
        <div
          class={`glass-card p-6 rounded-2xl flex flex-col justify-between relative overflow-hidden group hover:border-indigo-500/50 transition-all ${gridClasses}`}
          data-product-id={product.id}
          data-priority={Math.round(priorityScore)}
        >
          <!-- Großes Icon im Hintergrund -->
          <div class="absolute -right-4 -top-4 text-7xl opacity-10 group-hover:opacity-20 group-hover:scale-110 transition-all duration-300">
            {product.image}
          </div>

          <!-- Content -->
          <div>
            <div class="flex justify-between items-center mb-3 relative z-10">
              <span class={`text-xs px-3 py-1 rounded-full text-white ${badgeColor} font-mono font-semibold`}>
                {badgeLabel}
              </span>
              <span class="text-xs text-gray-500 font-mono">
                Score: {Math.round(priorityScore)}
              </span>
            </div>

            <h3 class="text-lg md:text-xl font-bold tracking-tight group-hover:text-indigo-400 transition-colors relative z-10 mb-1">
              {product.title}
            </h3>

            <p class="text-xs text-gray-400 font-mono relative z-10">
              {product.category} • EPC: ${product.epcValue.toFixed(2)}
            </p>

            <p class="text-sm text-gray-300 mt-2 relative z-10">
              {product.description}
            </p>
          </div>

          <!-- CTA Button -->
          <div class="mt-4 flex gap-2 relative z-10">
            <a
              href={`/affiliate/${product.id}`}
              class="flex-1 bg-indigo-600/20 hover:bg-indigo-600 border border-indigo-500/40 hover:border-indigo-500 text-center py-2 rounded-lg text-sm font-semibold tracking-wide transition-all group/btn"
              data-affiliate-id={product.id}
              data-network={product.affiliateNetwork}
            >
              <span class="group-hover/btn:text-white transition">→ AFFILIATE_LINK</span>
            </a>
            <button
              class="px-3 py-2 border border-gray-500/30 hover:border-indigo-500/50 rounded-lg text-sm transition"
              title="Detailansicht"
            >
              ◆
            </button>
          </div>

          <!-- Performance Metrics (nur bei Hover sichtbar) -->
          <div class="absolute inset-0 bg-black/60 backdrop-blur-sm rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-20 p-4">
            <div class="text-center">
              <div class="text-sm font-mono text-indigo-400 mb-3">Performance Metrics</div>
              <div class="space-y-1 text-xs text-gray-300">
                <div>Trend Score: <span class="text-indigo-400 font-bold">{product.trendScore}/100</span></div>
                <div>Forecast Growth: <span class="text-indigo-400 font-bold">×{product.forecastGrowth}</span></div>
                <div>Expected EPC: <span class="text-green-400 font-bold">${product.epcValue}</span></div>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Info-Banner -->
  <div class="mt-8 p-4 bg-indigo-500/10 border border-indigo-500/20 rounded-lg text-sm text-gray-300">
    <span class="font-mono text-indigo-400">💡 Elite Intelligence:</span> Produkte werden in Echtzeit nach Trend-Score × Forecast-Growth gereiht. Die größeren Karten = höhere ROI-Potenziale.
  </div>
</section>

<style>
  .glass-card {
    @apply bg-white/5 backdrop-blur-md border border-white/10;
  }
</style>
